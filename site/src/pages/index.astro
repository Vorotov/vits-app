---
import Base from '../layouts/Base.astro';
import StoreButton from '../components/StoreButton.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Scene from '../components/Scene.astro';
import today from '../assets/screens/today.png';
---
<Base title="VitoMy: Supplement Planner" description="Plan your supplement cycles, get reminders, mark what you take. All on-device.">
  <section class="hero wrap">
    <div class="hero__copy">
      <h1>Plan what you take. See&nbsp;it laid&nbsp;out.</h1>
      <p class="hero__sub">Set on and off weeks once. VitoMy shows what is due today and how the months line up.</p>
      <div class="ctas"><StoreButton store="apple" /><StoreButton store="google" /></div>
    </div>
    <PhoneFrame class="hero__phone" src={today} alt="The Today screen: the doses due today in one list, each with its time, ready to mark taken" priority />
  </section>

  <Scene />

  <section class="band">
    <div class="wrap">
      <h2>Coming to iPhone and Android.</h2>
      <p class="muted">No account and no server. What you enter stays on your phone.</p>
      <div class="ctas"><StoreButton store="apple" /><StoreButton store="google" /></div>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: calc(100dvh - var(--header-h));
    display: grid; gap: 3rem; align-items: center;
    padding-block: min(6rem, 10vh) 4rem;
  }
  .hero__sub { margin-top: 1.25rem; font-size: 1.125rem; color: var(--ink-2); max-width: 34ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero__phone { justify-self: center; }
  @media (min-width: 1024px) {
    .hero { grid-template-columns: 7fr 5fr; }
    .hero__phone {
      justify-self: end;
      /* The frame's width has to follow from the height the hero can spare,
         not the other way round. The screenshot is a fixed 1320x2868, so
         width = height * 0.46; 10rem is the hero's own padding plus slack.
         Without this a 900px-tall laptop clips the bottom of the frame, which
         reads as a broken image rather than a deliberate bleed. */
      width: min(100%, 360px, calc((100dvh - var(--header-h) - 10rem) * 0.46));
    }
  }
  @media (max-width: 640px) {
    .ctas :global(.store) { width: 100%; justify-content: center; }
  }

  .band { background: var(--canvas); padding-block: 5rem; margin-top: 4rem; }
  .band .muted { margin-top: 1rem; }

  /* The band reveals itself as it enters, driven by the scroll position of
     its own children rather than by a listener: `animation-timeline: view()`
     is the CSS scroll-driven form, so there is no JavaScript on this page
     outside the pinned scene. Both gates are load-bearing. `@supports` keeps
     Safari and Firefox, which do not implement it yet, showing the band as
     it is rather than stuck at `opacity: 0` forever, and the reduced-motion
     query is the same promise the hero and the scene make.

     LONGHANDS, deliberately, and not `animation: rise linear both`. The
     `animation` shorthand cannot carry a timeline: scroll-animations-1 took
     `<single-animation-timeline>` back out of it, so the shorthand only ever
     RESETS the timeline to `auto`. Written as a shorthand plus a following
     `animation-timeline` longhand the source is correct, but the build's
     minifier folds the pair back into `animation: linear both rise view()`,
     which Chrome parses as invalid and drops whole: measured on the built
     page, `animationName` came back `none` and `animationTimeline` `auto`
     while the untouched `animation-range` stayed. Five longhands give the
     minifier nothing to fold and survive the build byte for byte. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .band .wrap > * {
        animation-name: rise;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > *, .hero__phone { animation: rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .hero__copy > :nth-child(2) { animation-delay: 0.08s; }
    .hero__copy > :nth-child(3) { animation-delay: 0.16s; }
    .hero__phone { animation-delay: 0.2s; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
</style>
