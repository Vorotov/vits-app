  "fixed_sql": [
    {
      "name": "supplements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"supplements\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"name\" TEXT NOT NULL, \"dose_text\" TEXT NOT NULL, \"color_value\" INTEGER NOT NULL, \"note\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "regimens",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"regimens\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"supplement_id\" TEXT NOT NULL REFERENCES supplements (id), \"kind\" INTEGER NOT NULL, \"start_date\" TEXT NOT NULL, \"end_date\" TEXT NULL, \"on_days\" INTEGER NOT NULL DEFAULT 0, \"off_days\" INTEGER NOT NULL DEFAULT 0, \"paused\" INTEGER NOT NULL DEFAULT 0 CHECK (\"paused\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "regimen_slots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"regimen_slots\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"regimen_id\" TEXT NOT NULL REFERENCES regimens (id), \"minutes_from_midnight\" INTEGER NOT NULL, \"dose_label\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "intake_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"intake_logs\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"regimen_id\" TEXT NOT NULL REFERENCES regimens (id), \"slot_id\" TEXT NOT NULL REFERENCES regimen_slots (id), \"date\" TEXT NOT NULL, \"status\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"slot_id\", \"date\"));"
        }
      ]
    }
  ]
